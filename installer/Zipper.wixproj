<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <OutputName>Zipper</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PublishDir=$(MSBuildThisFileDirectory)..\artifacts\publish\;IconFile=$(MSBuildThisFileDirectory)..\src\Zipper\Zipper.ico</DefineConstants>
  </PropertyGroup>
</Project>
